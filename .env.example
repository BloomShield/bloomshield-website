# Optional contact form delivery. Get an API key at resend.com and verify your domain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Website <website@bloomshield.org>
CONTACT_TO_EMAIL=info@bloomshield.org

# Optional public GA4 identifier. Analytics remains disabled when absent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-VE12VJKP4F

# Optional public Microsoft Clarity project ID. Clarity remains disabled when absent.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# VCSE programme: leave closed and unlisted during preparation.
VCSE_EOI_OPEN=false
VCSE_EOI_LISTED=false
# staging or production: must match the Vercel deployment environment.
VCSE_EOI_ENVIRONMENT=staging
VCSE_EOI_DATABASE_URL=
VCSE_EOI_FROM_EMAIL=
VCSE_EOI_TO_EMAIL=
# Independent random secrets; never NEXT_PUBLIC.
VCSE_EOI_RATE_SALT=
VCSE_EOI_RETRY_SECRET=
# Resend endpoint-specific signing secret for delivery/bounce notifications.
VCSE_EOI_WEBHOOK_SECRET=
# Signs the exact route-specific declaration/offer/privacy snapshot shown at load.
VCSE_EOI_DECLARATION_SECRET=
# Exact browser origin for this deployment, e.g. protected Preview URL.
VCSE_EOI_ORIGIN=
